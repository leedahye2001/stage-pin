{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/goods",
      "destination": "https://stage-pin-api.onrender.com/api/v1/goods"
    },
    {
      "source": "/api/v1/goods/:path*",
      "destination": "https://stage-pin-api.onrender.com/api/v1/goods/:path*"
    },
    {
      "source": "/api/v1/auth/:path*",
      "destination": "https://stage-pin-api.onrender.com/api/v1/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
