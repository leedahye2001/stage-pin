{
  "expo": {
    "name": "StagePin",
    "slug": "stage-pin",
    "scheme": "stagepin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/stagepin-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leedahye.stagepin"
    },
    "android": {
      "package": "com.leedahye.stagepin",
      "adaptiveIcon": {
        "backgroundColor": "#1D1A24",
        "foregroundImage": "./assets/stagepin-mark.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/stagepin-favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-maps",
      "expo-font",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "핀로그에 넣을 공연 사진을 선택할 수 있도록 사진 접근을 허용해 주세요."
        }
      ]
    ]
  }
}
