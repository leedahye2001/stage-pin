# Render server-only environment. Not used by local Compose.
# Copy the actual host and username from Supabase Connect > Session pooler.
SPRING_PROFILES_ACTIVE=supabase
DB_HOST=YOUR_SESSION_POOLER_HOST
DB_PORT=5432
DB_NAME=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DATABASE_PASSWORD
# Keep the existing KOPIS, Kakao, app URL and other server settings in Render.
